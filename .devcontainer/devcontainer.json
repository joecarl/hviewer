{
	"name": "hViewer Dev Environment",
	"image": "mcr.microsoft.com/devcontainers/typescript-node",
	"runArgs": [
		//"--network=container:myvpn-container"  Uncomment and set your VPN container name if needed
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			]
		}
	},
	"mounts": [
		"source=${localEnv:HOME}/,target=/host-home,type=bind"
	],
	"postCreateCommand": "bash ./.devcontainer/install-ffmpeg.sh && cd frontend && npm install && cd ../backend && npm install"
}